<%@ taglib prefix="c"   uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%--
    =====================================================================
    footer.jspf  -  Unidades Tecnológicas de Santander (UTS)
    Sistema de Gestión de Trabajos de Grado
    ---------------------------------------------------------------------
    Pie de página común a todas las vistas del sistema.
    Incluye:
      * Cierre de la etiqueta <main> abierta en header.jspf.
      * <footer> pegado al fondo (mt-auto bg-dark text-white).
      * Scripts JS de Bootstrap 5 (CDN).

    USO: incluir SIEMPRE después del contenido y de header.jspf:
        <%@ include file="/WEB-INF/jspf/footer.jspf" %>
    =====================================================================
--%>

    </main>
    <%-- ===================== FIN DEL CONTENIDO PRINCIPAL ===================== --%>

    <%-- =============================================================
         PIE DE PÁGINA INSTITUCIONAL
         ============================================================= --%>
    <footer class="mt-auto bg-dark text-white py-3">
        <div class="container">
            <div class="row align-items-center gy-2">

                <div class="col-md-6 text-center text-md-start">
                    <span class="fw-semibold d-inline-flex align-items-center">
                <span class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle me-2"
                      style="width: 28px; height: 28px;">
                    <img src="${ctx}/assets/img/utslogo.png" alt="UTS" height="20" />
                </span>
                Unidades Tecnológicas de Santander
            </span>
                </div>

                <div class="col-md-6 text-center text-md-end small">
                    <%-- Año actual sin scriptlets: se obtiene la fecha del sistema --%>
                    <jsp:useBean id="fechaActual" class="java.util.Date" scope="page" />
                    <span>
                        &copy; <fmt:formatDate value="${fechaActual}" pattern="yyyy" />
                        Unidades Tecnológicas de Santander (UTS) - Sistema de Trabajos de Grado.
                        Todos los derechos reservados.
                    </span>
                </div>

            </div>
        </div>
    </footer>

    <%-- Bootstrap 5 JS Bundle (incluye Popper) --%>
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>

</body>
</html>
