<%--
    =====================================================================
    header.jspf  -  Unidades Tecnológicas de Santander (UTS)
    Sistema de Gestión de Trabajos de Grado
    ---------------------------------------------------------------------
    Cabecera común a todas las vistas del sistema.
    Incluye:
      * Estructura HTML5 + meta viewport + título con <c:out>.
      * Bootstrap 5 (CDN) y Bootstrap Icons (CDN).
      * Barra superior institucional (bg-danger).
      * Barra de navegación responsive (navbar-dark bg-success) que
        evalúa ${sessionScope.usuario}.
      * Apertura de <main class="container my-4 flex-grow-1">.

    USO EN UNA PÁGINA:
        <%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
        <%@ include file="/WEB-INF/jspf/conexion.jspf" %>
        <%@ include file="/WEB-INF/jspf/header.jspf" %>
        ... contenido ...
        <%@ include file="/WEB-INF/jspf/footer.jspf" %>

    El atributo de sesión esperado es "usuario" con los campos:
        nombres, apellidos, rol, nivelFormacion
    (todos accesibles por EL: ${sessionScope.usuario.nombres}, etc.)
    =====================================================================
--%>
<%@ taglib prefix="c"   uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="fn"  uri="http://java.sun.com/jsp/jstl/functions" %>

<%--
    Locale explícito del sistema (Colombia / UTS).
    IMPORTANTE: sin <fmt:setLocale>, JSTL calcula el locale a partir de la
    cabecera Accept-Language del navegador y, si no puede resolverlo,
    cae en un fallback que imprime Date.toString() en lugar de aplicar
    el "pattern" (p. ej. <fmt:formatDate pattern="yyyy"/> mostraría
    "Sun Oct 18 ... 2026"). Fijarlo aquí garantiza un formato estable
    para fechas y números en todas las vistas.
--%>
<fmt:setLocale value="es_CO" />

<c:set var="ctx" value="${pageContext.request.contextPath}" />

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="Unidades Tecnológicas de Santander - UTS" />
    <title>
        <c:out value="${empty pageTitle ? 'Sistema de Trabajos de Grado - UTS' : pageTitle}" />
    </title>

    <%-- Favicon institucional --%>
    <link rel="icon" type="image/png" href="${ctx}/assets/img/utslogo.png" />
    <link rel="apple-touch-icon" href="${ctx}/assets/img/utslogo.png" />

    <%-- Bootstrap 5 CSS (CDN) --%>
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous" />

    <%-- Bootstrap Icons (CDN) --%>
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <%-- Tipografía institucional (Google Fonts) --%>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inconsolata:wght@200..900&display=swap" rel="stylesheet">

    <%-- Estilos propios mínimos del sistema --%>
    <style>
        html,
        body {
            height: 100%;
        }
        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background-color: #F8F9FA;
            color: #212529;
            font-family: 'Inconsolata', monospace;
            font-size: 1.0625rem;   /* 17px: lectura más cómoda que 16px */
            line-height: 1.6;
        }
        h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6 {
            font-family: 'Archivo Black', sans-serif;
            font-weight: 400;
            line-height: 1.25;
            letter-spacing: .2px;
        }
        /* Jerarquía tipográfica fluida: crece con el ancho de la ventana y se
           detiene en un máximo, así no rompe el responsive ni desborda las
           tarjetas y tablas. */
        h1, .h1 { font-size: clamp(1.75rem, 1.45rem + 1.4vw, 2.15rem); }
        h2, .h2 { font-size: clamp(1.5rem, 1.3rem + 1vw, 1.8rem); }
        h3, .h3 { font-size: clamp(1.3rem, 1.15rem + .7vw, 1.55rem); }
        h4, .h4 { font-size: clamp(1.2rem, 1.1rem + .45vw, 1.38rem); }
        h5, .h5 { font-size: 1.15rem; }
        h6, .h6 { font-size: 1.08rem; }
        /* Los textos secundarios (.small) suben en proporción para no quedar
           diminutos junto al nuevo tamaño base. */
        .small,
        small {
            font-size: .9em;
        }
        .btn, .nav-link, .form-label, .form-control, .form-select, .table, .badge {
            font-family: 'Inconsolata', monospace;
        }
        .btn {
            font-weight: 600;
        }
        .card {
            border-radius: var(--bs-border-radius-xl);
            box-shadow: 0 .25rem .75rem rgba(33, 37, 41, .06);
        }
        .uts-topbar {
            letter-spacing: 0.3px;
            border-bottom: 1px solid #dee2e6;
        }
        .uts-navbar .navbar-brand {
            font-family: 'Archivo Black', sans-serif;
            font-size: 1.1rem;
        }
        .uts-user-badge {
            font-size: 0.78rem;
            text-transform: uppercase;
        }
        /* El sidebar mantiene su ancho: el texto largo se recorta, no empuja. */
        .uts-nav-link {
            font-size: .95rem;
        }
    </style>
</head>

<body>

    <%-- =============================================================
         1. BARRA SUPERIOR INSTITUCIONAL (Rojo UTS)
         ============================================================= --%>
    <div class="uts-topbar bg-white text-success text-center py-2 px-3">
        <span class="fw-bold">
            <img src="${ctx}/assets/img/utslogo.png" alt="UTS" height="26" class="me-2 align-middle" />
            Unidades Tecnológicas de Santander - Sistema de Trabajos de Grado
        </span>
    </div>

    <%-- =============================================================
         2. BARRA DE NAVEGACIÓN RESPONSIVE (Verde UTS)
         Se adapta según exista o no usuario autenticado en sesión.
         ============================================================= --%>
    <nav class="navbar navbar-expand-lg navbar-dark bg-success uts-navbar shadow-sm">
        <div class="container">

            <a class="navbar-brand d-flex align-items-center" href="${ctx}/index.jsp">
                <span class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle me-2"
                      style="width: 40px; height: 40px;">
                    <img src="${ctx}/assets/img/utslogo.png" alt="UTS" height="30" />
                </span>
                Trabajos de Grado UTS
            </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarPrincipal"
                aria-controls="navbarPrincipal"
                aria-expanded="false"
                aria-label="Alternar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarPrincipal">

                <%-- -------- Usuario NO autenticado -------- --%>
                <c:if test="${empty sessionScope.usuario}">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="${ctx}/login.jsp">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                            </a>
                        </li>
                    </ul>
                </c:if>

                <%-- -------- Usuario SI autenticado -------- --%>
                <c:if test="${not empty sessionScope.usuario}">

                    <%-- Enlaces generales de navegación --%>
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="${ctx}/index.jsp">
                                <i class="bi bi-house-door me-1"></i> Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="${ctx}/dashboard.jsp">
                                <i class="bi bi-speedometer2 me-1"></i> Panel
                            </a>
                        </li>

                        <%-- RF-30: calendario académico (todos los roles) --%>
                        <li class="nav-item">
                            <a class="nav-link" href="${ctx}/consultas_transversales.jsp">
                                <i class="bi bi-calendar3 me-1"></i> Calendario Académico
                            </a>
                        </li>

                        <%-- RF-16, RF-32 a RF-35: accesos exclusivos del comité --%>
                        <c:if test="${sessionScope.usuario.rol eq 'COMITE' or sessionScope.usuario.rol eq 'ADMINISTRADOR'}">
                            <li class="nav-item">
                                <a class="nav-link" href="${ctx}/programar_sustentacion.jsp">
                                    <i class="bi bi-mic-fill me-1"></i> Sustentaciones
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="${ctx}/comite_informes.jsp">
                                    <i class="bi bi-graph-up-arrow me-1"></i> Informes y Búsquedas
                                </a>
                            </li>
                        </c:if>
                    </ul>

                    <%-- Datos del usuario en sesión --%>
                    <ul class="navbar-nav mb-2 mb-lg-0 align-items-lg-center">

                        <li class="nav-item me-lg-2">
                            <span class="navbar-text text-white">
                                <i class="bi bi-person-circle me-1"></i>
                                <strong>
                                    <c:out value="${sessionScope.usuario.nombres}" />
                                    <c:out value="${sessionScope.usuario.apellidos}" />
                                </strong>
                            </span>
                        </li>

                        <%-- Rol del usuario --%>
                        <li class="nav-item me-lg-2">
                            <span class="badge bg-light text-success uts-user-badge">
                                <i class="bi bi-shield-check me-1"></i>
                                <c:out value="${sessionScope.usuario.rol}" />
                            </span>
                        </li>

                        <%-- Nivel de formación: TECNOLOGIA / INGENIERIA --%>
                        <li class="nav-item me-lg-3">
                            <c:choose>
                                <c:when test="${sessionScope.usuario.nivelFormacion eq 'INGENIERIA'}">
                                    <span class="badge bg-primary uts-user-badge">
                                        <i class="bi bi-gear-wide-connected me-1"></i> INGENIERÍA
                                    </span>
                                </c:when>
                                <c:when test="${sessionScope.usuario.nivelFormacion eq 'TECNOLOGIA'}">
                                    <span class="badge bg-info text-dark uts-user-badge">
                                        <i class="bi bi-tools me-1"></i> TECNOLOGÍA
                                    </span>
                                </c:when>
                                <c:otherwise>
                                    <span class="badge bg-secondary uts-user-badge">
                                        <i class="bi bi-question-circle me-1"></i> SIN NIVEL
                                    </span>
                                </c:otherwise>
                            </c:choose>
                        </li>

                        <%-- Botón de cierre de sesión --%>
                        <li class="nav-item">
                            <a class="btn btn-danger btn-sm" href="${ctx}/logout.jsp">
                                <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                            </a>
                        </li>

                    </ul>
                </c:if>

            </div>
        </div>
    </nav>

    <%-- =============================================================
         3. APERTURA DEL CONTENIDO PRINCIPAL
         (se cierra en footer.jspf)
         ============================================================= --%>
    <main class="container my-4 flex-grow-1">
